# GP Practice Documents API - Environment Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
SERVER_PORT=8080

# Database Configuration
DATABASE_URL=mssql+pyodbc://sa:Hc4u!1peter5v7@mssql.mssql.svc.cluster.local:1433/gp_practices?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=no

# Document Processing Mode (SYNC, ASYNC, HYBRID)
PROCESSING_MODE=HYBRID

# ClamAV Configuration
CLAMAV_HOST=clamav.malware-check.svc.cluster.local
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=5000

# MinIO Configuration
MINIO_URL=minio.malware-check.svc.cluster.local:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=quarantined

# RabbitMQ Configuration
RABBITMQ_HOST=production-rabbitmqcluster.default.svc.cluster.local
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE_NAME=quarantined

# Logging
LOG_LEVEL=INFO
